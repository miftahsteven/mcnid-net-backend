generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  name             String
  username         String?    @unique
  email            String     @unique
  image            String?
  passwordHash     String?
  role             Role       @default(EDITOR)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  twoFactorEnabled Boolean    @default(false)
  twoFactorSecret  String?
  auditLogs        AuditLog[]
  courses          Course[]   @relation("CourseAuthor")
  posts            Post[]
  videos           Video[]

  @@map("users")
}

model Post {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  content      String
  excerpt      String?
  coverImage   String?
  status       PostStatus     @default(DRAFT)
  publishedAt  DateTime?
  seoTitle     String?
  seoDesc      String?
  schemaJson   Json?
  authorId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  customAuthor String?
  type         String         @default("news")
  isHighlight  Boolean        @default(false)
  viewCount    Int            @default(0)
  categories   PostCategory[]
  tags         PostTag[]
  author       User           @relation(fields: [authorId], references: [id])

  @@map("posts")
}

model Category {
  id     String          @id @default(cuid())
  name   String          @unique
  slug   String          @unique
  posts  PostCategory[]
  videos VideoCategory[]

  @@map("categories")
}

model PostCategory {
  postId     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@map("post_categories")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Page {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  published Boolean @default(false)
  blocks    Block[]

  @@map("pages")
}

model Block {
  id      String  @id @default(cuid())
  type    String
  order   Int
  active  Boolean @default(true)
  content Json
  pageId  String
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("blocks")
}

model Media {
  id            String   @id @default(cuid())
  filename      String
  url           String
  type          String
  size          Int
  mimeType      String
  alt           String?
  createdAt     DateTime @default(now())
  showInGallery Boolean  @default(false)

  @@map("media")
}

model ChatLog {
  id        String   @id @default(cuid())
  sessionId String
  question  String
  answer    String
  intent    String?
  ipHash    String?
  tokens    Int?
  createdAt DateTime @default(now())

  @@map("chat_logs")
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  title     String
  content   String
  source    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_base")
}

model Work {
  id         String   @id @default(cuid())
  title      String
  type       WorkType
  content    String?
  fileUrl    String?
  repoUrl    String?
  doi        String?
  publisher  String?
  year       Int?
  references String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("works")
}

model GalleryItem {
  id        String          @id @default(cuid())
  type      GalleryItemType
  title     String?
  url       String
  order     Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@map("gallery_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Karya {
  id           String        @id @default(cuid())
  category     KaryaCategory
  sumber       String        @default("cholilnafis.id")
  title        String
  shortcontent String?
  fullcontent  String
  fileUrl      String?
  status       PostStatus    @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("karya")
}

model Video {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?
  sourceType  VideoSourceType @default(YOUTUBE)
  videoUrl    String?
  coverImage  String?
  duration    String?
  isHighlight Boolean         @default(false)
  status      PostStatus      @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  viewCount   Int             @default(0)
  likeCount   Int             @default(0)
  dislikeCount Int             @default(0)
  categories  VideoCategory[]
  author      User            @relation(fields: [authorId], references: [id])

  @@map("videos")
}

model VideoCategory {
  videoId    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, categoryId])
  @@map("video_categories")
}

model Course {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String?
  coverImage     String?
  category       String         @default("Umum")
  level          String         @default("Pemula")
  durationHours  Float?
  price          Float          @default(0)
  hasCertificate Boolean        @default(false)
  status         CourseStatus   @default(DRAFT)
  authorId       String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  modules        CourseModule[]
  author         User           @relation("CourseAuthor", fields: [authorId], references: [id])
  enrollments    Enrollment[]

  @@map("courses")
}

model CourseModule {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@map("course_modules")
}

model Lesson {
  id          String           @id @default(cuid())
  title       String
  type        LessonType       @default(VIDEO)
  content     String?
  videoUrl    String?
  fileUrl     String?
  durationMin Int?
  order       Int              @default(0)
  isFree      Boolean          @default(false)
  moduleId    String
  createdAt   DateTime         @default(now())
  progress    LessonProgress[]
  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Enrollment {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  paymentStatus String   @default("free")
  enrolledAt    DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  watchedSec  Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model MediaMonitoringCache {
  id           String   @id @default(cuid())
  query        String
  dateFrom     String
  dateTo       String
  resultsData  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([query, dateFrom, dateTo])
  @@map("media_monitoring_cache")
}

model SocmedProfile {
  id              String   @id @default(cuid())
  handle          String   // e.g. @cholilnafis
  platform        String   // instagram, tiktok, x, facebook
  name            String?
  avatar          String?
  bio             String?
  followers       Int      @default(0)
  following       Int      @default(0)
  posts           Int      @default(0)
  er              Float    @default(0)
  avgLikes        Float    @default(0)
  avgComments     Float    @default(0)
  recentTrend     Json?    // Array of engagement counts or rates
  followersTrend  Json?    // Array of followers counts over time
  trendDates      Json?    // Array of dates for the above trends
  isPrivate       Boolean  @default(false)
  posts_detail    SocmedPost[]
  lastScraped     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([handle, platform])
  @@index([handle, platform])
  @@map("socmed_profiles")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MODERATOR
  PENGAJAR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REVIEW
}

enum WorkType {
  BUKU
  JURNAL
  ARTIKEL
  KARYA_DIGITAL
}

enum GalleryItemType {
  IMAGE
  VIDEO_YOUTUBE
}

enum KaryaCategory {
  ArtikelKoran
  KaryaBuku
  Khotbah
  Artikel
  Materi
}

enum VideoSourceType {
  UPLOAD
  YOUTUBE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  PDF
}

model SocmedPost {
  id            String   @id @default(cuid())
  postId        String   // Unique ID from platform
  url           String
  type          String   // Image, Video, Sidecar, etc.
  displayUrl    String?  // Local saved image path
  caption       String?  @db.Text
  timestamp     DateTime
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  reposts       Int      @default(0)
  shared        Int      @default(0)
  viewsCount    Int      @default(0)
  er            Float    @default(0)
  hashtags      Json?    // Array of strings
  profileId     String
  profile       SocmedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([postId, profileId])
  @@map("socmed_posts")
}

model SnaUserNode {
  id            String   @id
  username      String
  followers     Int?
  createdAt     DateTime @default(now())
  interactionsAsSource SnaInteraction[] @relation("sourceUser")
  interactionsAsTarget SnaInteraction[] @relation("targetUser")

  @@map("sna_user_nodes")
}

model SnaTweet {
  id            String   @id
  text          String   @db.Text
  createdAt     DateTime
  userId        String
  snaResultId   String
  snaResult     SnaResult @relation(fields: [snaResultId], references: [id], onDelete: Cascade)

  @@map("sna_tweets")
}

model SnaInteraction {
  id            String   @id @default(uuid())
  sourceUserId  String
  targetUserId  String
  type          String   // retweet | reply | mention
  tweetId       String
  createdAt     DateTime @default(now())
  snaResultId   String
  snaResult     SnaResult @relation(fields: [snaResultId], references: [id], onDelete: Cascade)
  
  sourceUser    SnaUserNode @relation("sourceUser", fields: [sourceUserId], references: [id])
  targetUser    SnaUserNode @relation("targetUser", fields: [targetUserId], references: [id])

  @@map("sna_interactions")
}

model SnaResult {
  id            String   @id @default(uuid())
  keyword       String
  totalNodes    Int
  totalEdges    Int
  graphData     Json?    // Store the processed graph for quick retrieval
  analytics     Json?    // Store centrality/community results
  createdAt     DateTime @default(now())
  tweets        SnaTweet[]
  interactions  SnaInteraction[]

  @@map("sna_results")
}
